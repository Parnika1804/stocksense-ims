generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      String   @default("staff")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts   Receipt[]
  deliveries Delivery[]
}

model Warehouse {
  id        Int        @id @default(autoincrement())
  name      String
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  locations Location[]
}

model Location {
  id          Int       @id @default(autoincrement())
  name        String
  aisle       String?
  bay         String?
  level       String?
  warehouseId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  stockItems  StockItem[]
  movesFrom   StockMove[]  @relation("MoveFrom")
  movesTo     StockMove[]  @relation("MoveTo")
  adjustments Adjustment[]
  transfersFrom Transfer[] @relation("TransferFrom")
  transfersTo   Transfer[] @relation("TransferTo")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  description String?
  unit        String   @default("pcs")
  reorderQty  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockItems    StockItem[]
  receiptLines  ReceiptLine[]
  deliveryLines DeliveryLine[]
  stockMoves    StockMove[]
  adjustments   Adjustment[]
  transfers     Transfer[]
}

model StockItem {
  id         Int      @id @default(autoincrement())
  productId  Int
  locationId Int
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
}

model Receipt {
  id          Int           @id @default(autoincrement())
  reference   String        @unique
  supplierId  String?
  status      String        @default("draft") // draft | confirmed | received
  receivedAt  DateTime?
  createdById Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy    User          @relation(fields: [createdById], references: [id])
  receiptLines ReceiptLine[]
}

model ReceiptLine {
  id          Int     @id @default(autoincrement())
  receiptId   Int
  productId   Int
  expectedQty Int
  receivedQty Int     @default(0)

  receipt Receipt @relation(fields: [receiptId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Delivery {
  id          Int            @id @default(autoincrement())
  reference   String         @unique
  customerId  String?
  status      String         @default("draft") // draft | confirmed | shipped
  shippedAt   DateTime?
  createdById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy     User           @relation(fields: [createdById], references: [id])
  deliveryLines DeliveryLine[]
}

model DeliveryLine {
  id         Int  @id @default(autoincrement())
  deliveryId Int
  productId  Int
  qty        Int

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
}

model StockMove {
  id           Int      @id @default(autoincrement())
  productId    Int
  fromLocation Int?
  toLocation   Int?
  quantity     Int
  reason       String?
  createdAt    DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  from     Location? @relation("MoveFrom", fields: [fromLocation], references: [id])
  to       Location? @relation("MoveTo", fields: [toLocation], references: [id])
}

model Adjustment {
  id               Int      @id @default(autoincrement())
  productId        Int
  locationId       Int
  previousQuantity Int
  countedQuantity  Int
  difference       Int
  reason           String?
  createdAt        DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
}

model Transfer {
  id             Int      @id @default(autoincrement())
  productId      Int
  fromLocationId Int
  toLocationId   Int
  quantity       Int
  reason         String?
  createdAt      DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id])
  fromLocation Location @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location @relation("TransferTo",   fields: [toLocationId],   references: [id])
}
